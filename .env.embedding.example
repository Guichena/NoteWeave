# NoteWeave embedding runtime configuration
# Fill these values, then load them into your shell or merge into your local .env.

# Enable embedding and disable the deterministic stub.
EMBEDDING_ENABLED=true
EMBEDDING_STUB_ENABLED=false

# OpenAI-compatible embedding endpoint.
# DashScope-compatible default:
EMBEDDING_API_BASE_URL=https://api.zetatechs.com

# Required when EMBEDDING_STUB_ENABLED=false.
EMBEDDING_API_KEY=

# Use the exact model name exposed by your provider.
EMBEDDING_MODEL=jina-embeddings-v5-text-nano

# Keep this in sync with the provider, otherwise vector indexing will drift.
EMBEDDING_DIMENSION=768

# Safe starting batch size for backfill and query embedding.
EMBEDDING_BATCH_SIZE=10

# Hybrid retrieval defaults used by Phase 9 / Phase 10 review.
RAG_RETRIEVAL_MODE=HYBRID
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=1.0
RAG_WIKI_WEIGHT=1.3
RAG_RRF_K=60
RAG_MIN_SCORE=0.0
