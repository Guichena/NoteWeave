SERVER_PORT=18082

MYSQL_PORT=13307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=noteweave
MYSQL_USER=noteweave
MYSQL_PASSWORD=noteweave

REDIS_PORT=6380

MINIO_PORT=19100
MINIO_CONSOLE_PORT=19101
MINIO_ROOT_USER=noteweave
MINIO_ROOT_PASSWORD=noteweave-minio-secret
MINIO_ACCESS_KEY=noteweave
MINIO_SECRET_KEY=noteweave-minio-secret
MINIO_BUCKET=noteweave-dev
MINIO_TEST_BUCKET=noteweave-test

ES_PORT=19200
ES_JAVA_OPTS=-Xms512m -Xmx512m

NOTEWEAVE_LLM_STUB_ENABLED=true
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_API_MODEL=deepseek-chat

EMBEDDING_ENABLED=true
EMBEDDING_STUB_ENABLED=false
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=8
EMBEDDING_BATCH_SIZE=10

KAFKA_PORT=19092
NOTEWEAVE_KAFKA_TOPIC_TASK=noteweave.task
NOTEWEAVE_KAFKA_TOPIC_DOCUMENT=noteweave.document
NOTEWEAVE_KAFKA_GROUP_TASK=noteweave-task-worker

NOTEWEAVE_TASK_DISPATCHER_ENABLED=true
NOTEWEAVE_TASK_DISPATCHER_FIXED_DELAY_MS=5000

NOTEWEAVE_UPLOAD_CLEANUP_ENABLED=true
NOTEWEAVE_UPLOAD_CLEANUP_FIXED_DELAY_MS=600000

NOTEWEAVE_SOURCE_URL_CONNECT_TIMEOUT_SECONDS=5
NOTEWEAVE_SOURCE_URL_READ_TIMEOUT_SECONDS=10
NOTEWEAVE_SOURCE_URL_MAX_REDIRECTS=3
NOTEWEAVE_SOURCE_URL_MAX_RESPONSE_BYTES=1048576

RAG_RETRIEVAL_MODE=HYBRID
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=1.0
RAG_WIKI_WEIGHT=1.3
RAG_RRF_K=60
RAG_MIN_SCORE=0.0
