# Development-only defaults for docker compose --profile app.
NOTEWEAVE_HOST_BIND_ADDRESS=127.0.0.1
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
MYSQL_DATABASE=noteweave
MYSQL_USER=noteweave
MYSQL_PASSWORD=replace-with-a-strong-mysql-application-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
KAFKA_CLIENT_USERNAME=noteweave
KAFKA_CLIENT_PASSWORD=replace-with-a-strong-kafka-password
ELASTIC_PASSWORD=replace-with-a-strong-elasticsearch-password
NOTEWEAVE_INTERNAL_AUTH_TOKEN=replace-with-a-long-random-development-token
NOTEWEAVE_RESEARCH_INTERNAL_AUTH_TOKEN=replace-with-a-dedicated-research-worker-token
NOTEWEAVE_ARTIFACT_INTERNAL_AUTH_TOKEN=replace-with-a-dedicated-artifact-worker-token
NOTEWEAVE_ARTIFACT_CALLBACK_SECRET=replace-with-artifact-callback-secret
MINIO_ROOT_USER=noteweave-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-development-password

NOTEWEAVE_ENVIRONMENT=development
NOTEWEAVE_LOCAL_USER_FALLBACK=false
NOTEWEAVE_KAFKA_ENABLED=true
# Elasticsearch is on by default because Compose starts the search node.
# Fill ELASTIC_PASSWORD above; leave this true unless you are isolating infra.
NOTEWEAVE_ES_ENABLED=true
NOTEWEAVE_QA_MYSQL_FALLBACK_ENABLED=true
NOTEWEAVE_NOTE_LOCAL_METADATA_FALLBACK_ENABLED=true
NOTEWEAVE_WORKER_ARTIFACT_BASE_URL=http://localhost:18092
NOTEWEAVE_WORKER_CONNECT_TIMEOUT_SECONDS=3
NOTEWEAVE_WORKER_READ_TIMEOUT_SECONDS=30
NOTEWEAVE_MCP_SANDBOX_ROOT=./workers/artifact-worker/runtime
NOTEWEAVE_ES_USERNAME=elastic
NOTEWEAVE_ES_PASSWORD=${ELASTIC_PASSWORD}
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=4
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT_MS=30000
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT_MS=5000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME_MS=1800000
# Set these only for first-run account provisioning, then remove the password from the environment.
NOTEWEAVE_BOOTSTRAP_USERNAME=admin
NOTEWEAVE_BOOTSTRAP_EMAIL=admin@example.invalid
NOTEWEAVE_BOOTSTRAP_DISPLAY_NAME=NoteWeave Admin
NOTEWEAVE_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
NOTEWEAVE_QUOTA_ENABLED=true
NOTEWEAVE_QUOTA_LOCAL_FALLBACK_ENABLED=false
NOTEWEAVE_QUOTA_RATE_CAPACITY=20
NOTEWEAVE_QUOTA_RATE_REFILL_PER_MINUTE=20
NOTEWEAVE_QUOTA_CONCURRENCY_LIMIT=4
NOTEWEAVE_QUOTA_LEASE_SECONDS=300
NOTEWEAVE_QUOTA_LOCAL_RATE_CAPACITY=5
NOTEWEAVE_QUOTA_LOCAL_RATE_REFILL_PER_MINUTE=5
NOTEWEAVE_QUOTA_LOCAL_CONCURRENCY_LIMIT=1

# Provider switches default on. Copy this file to .env, then fill API keys and
# confirm endpoints/models before QA, Research, or Artifact can return results.
NOTEWEAVE_LLM_ENABLED=true
NOTEWEAVE_LLM_TEMPLATE_FALLBACK_ENABLED=false
NOTEWEAVE_LLM_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
NOTEWEAVE_LLM_API_KEY=
NOTEWEAVE_LLM_MODEL=Pro/zai-org/GLM-5.2
NOTEWEAVE_LLM_TIMEOUT_SECONDS=60

# Retrieval providers use dedicated credentials and are required by the final QA/Note runtime.
NOTEWEAVE_EMBEDDING_ENABLED=true
NOTEWEAVE_EMBEDDING_ENDPOINT=https://api.jina.ai/v1/embeddings
NOTEWEAVE_EMBEDDING_API_KEY=
NOTEWEAVE_EMBEDDING_MODEL=jina-embeddings-v5-text-small
NOTEWEAVE_EMBEDDING_DIMENSIONS=1024
NOTEWEAVE_EMBEDDING_DOCUMENT_BATCH_SIZE=32
NOTEWEAVE_EMBEDDING_QUERY_TIMEOUT_SECONDS=10
NOTEWEAVE_EMBEDDING_BATCH_TIMEOUT_SECONDS=60
NOTEWEAVE_EMBEDDING_MAX_INPUT_CHARACTERS=12000
NOTEWEAVE_EMBEDDING_MAX_ATTEMPTS=3

NOTEWEAVE_RERANK_ENABLED=true
NOTEWEAVE_RERANK_ENDPOINT=https://api.jina.ai/v1/rerank
NOTEWEAVE_RERANK_API_KEY=
NOTEWEAVE_RERANK_MODEL=jina-reranker-v3.5
NOTEWEAVE_RERANK_BATCH_SIZE=80
NOTEWEAVE_RERANK_MAX_DOCUMENT_CHARACTERS=1800
NOTEWEAVE_RERANK_TIMEOUT_SECONDS=20
NOTEWEAVE_RERANK_MAX_ATTEMPTS=3

NOTEWEAVE_RESEARCH_LLM_API_KEY=
NOTEWEAVE_RESEARCH_LLM_BASE_URL=https://api.siliconflow.cn/v1
NOTEWEAVE_RESEARCH_LLM_MODEL=Pro/zai-org/GLM-5.2
NOTEWEAVE_RESEARCH_LLM_TIMEOUT_SECONDS=60
NOTEWEAVE_RESEARCH_LLM_MAX_ATTEMPTS=3
NOTEWEAVE_RESEARCH_LLM_INPUT_COST_PER_MILLION=0
NOTEWEAVE_RESEARCH_LLM_OUTPUT_COST_PER_MILLION=0
NOTEWEAVE_RESEARCH_LLM_PURPOSE_OPTIONS={"research.extract":{"model":"deepseek-v4-flash","max_tokens":1600,"max_attempts":2},"research.synthesis":{"model":"deepseek-v4-flash","max_tokens":2400,"timeout_seconds":120,"max_attempts":2,"temperature":0.1}}
NOTEWEAVE_RESEARCH_PUBLIC_SEARCH_ENABLED=true
NOTEWEAVE_RESEARCH_SEARCH_PROVIDER_CHAIN=serper,wikipedia
NOTEWEAVE_RESEARCH_SEARCH_API_KEY=
NOTEWEAVE_RESEARCH_SEARCH_BASE_URL=https://google.serper.dev/search
NOTEWEAVE_RESEARCH_SEARCH_MAX_PAGES=2
NOTEWEAVE_RESEARCH_SERPER_API_KEY=
NOTEWEAVE_RESEARCH_SERPER_BASE_URL=https://google.serper.dev/search
NOTEWEAVE_RESEARCH_ENABLE_URL_READER=false
NOTEWEAVE_RESEARCH_JINA_API_KEY=
NOTEWEAVE_RESEARCH_JINA_BASE_URL=https://r.jina.ai/
# The durable incremental chain is the only supported Research Agent runtime.
NOTEWEAVE_RESEARCH_AGENT_EXECUTION_MODE=INCREMENTAL_V1
NOTEWEAVE_RESEARCH_AGENT_MAX_CONCURRENCY=1
NOTEWEAVE_RESEARCH_AGENT_BUNDLE_MAX_CELLS=3
# Dedicated Research Agent transport and credentials, isolated from main chat.
NOTEWEAVE_KAFKA_RESEARCH_AGENT_TOPIC=noteweave.research.agent.command
NOTEWEAVE_KAFKA_RESEARCH_AGENT_DLQ_TOPIC=noteweave.research.agent.command.dlq
NOTEWEAVE_KAFKA_RESEARCH_AGENT_GROUP_ID=noteweave-research-agent-worker
NOTEWEAVE_KAFKA_ARTIFACT_DLQ_TOPIC=noteweave.artifact.job.dlq
NOTEWEAVE_KAFKA_ARTIFACT_GROUP_ID=noteweave-artifact-worker
NOTEWEAVE_ARTIFACT_CONSUMER_ENABLED=true
NOTEWEAVE_KAFKA_ARTIFACT_MAX_POLL_INTERVAL_SECONDS=4200
NOTEWEAVE_RESEARCH_AGENT_CONSUMER_ENABLED=true
NOTEWEAVE_RESEARCH_AGENT_DEEP_CELL_EXECUTOR_ENABLED=true
NOTEWEAVE_RESEARCH_AGENT_EVIDENCE_AUDIT_ENABLED=false
NOTEWEAVE_RESEARCH_AGENT_SYNTHESIS_ENABLED=false
NOTEWEAVE_RESEARCH_AGENT_WIDE_DISCOVERY_ENABLED=false
NOTEWEAVE_RESEARCH_AGENT_FAKE_PROVIDER_ENABLED=false
NOTEWEAVE_RESEARCH_AGENT_COMMAND_DISPATCH_DELAY_MS=1000
NOTEWEAVE_RESEARCH_AGENT_COMMAND_DISPATCH_BATCH_SIZE=25
# A standard 5-cell run needs about 21 provider permits. Keep this above that
# baseline so a single low-concurrency run does not throttle itself.
NOTEWEAVE_RESEARCH_AGENT_RATE_LIMIT_CAPACITY=24
NOTEWEAVE_RESEARCH_AGENT_RATE_LIMIT_REFILL_PER_MINUTE=24
# Stable identity for the default single-worker Compose deployment. Override
# with a unique value for each additional worker replica.
NOTEWEAVE_RESEARCH_AGENT_WORKER_INSTANCE_ID=research-agent-worker-1
NOTEWEAVE_RESEARCH_AGENT_LEASE_SECONDS=60
NOTEWEAVE_RESEARCH_AGENT_HEARTBEAT_INTERVAL_SECONDS=15
NOTEWEAVE_RESEARCH_AGENT_HEARTBEAT_FAILURE_BUDGET_SECONDS=30
NOTEWEAVE_RESEARCH_AGENT_HEARTBEAT_REQUEST_TIMEOUT_SECONDS=5
NOTEWEAVE_RESEARCH_AGENT_COMPLETION_MAX_ATTEMPTS=3
NOTEWEAVE_RESEARCH_AGENT_DRAIN_GRACE_SECONDS=30
NOTEWEAVE_RESEARCH_AGENT_DRAIN_POLL_TIMEOUT_MS=500
NOTEWEAVE_KAFKA_CONSUME_MAX_ATTEMPTS=3
NOTEWEAVE_RESEARCH_LLM_MAX_TOTAL_CALLS=64
NOTEWEAVE_RESEARCH_LLM_MAX_INPUT_CHARS=120000
NOTEWEAVE_RESEARCH_LLM_CONTEXT_SAFETY_BUFFER_CHARS=8000
# Backend-authoritative upgrade flags. Keep disabled until their focused gates pass.
NOTEWEAVE_RESEARCH_STRICT_EVIDENCE_VALIDATION=false
NOTEWEAVE_RESEARCH_INTENT_MATRIX_V2=false
NOTEWEAVE_RESEARCH_RUNNABLE_WORK_V2=false
NOTEWEAVE_RESEARCH_CHECKPOINT_HYDRATION_V2=false
NOTEWEAVE_RESEARCH_EVIDENCE_AUDIT_V1=false
NOTEWEAVE_RESEARCH_WORKER_SYNTHESIS_V1=false
NOTEWEAVE_RESEARCH_WIDE_DISCOVERY_V1=false
NOTEWEAVE_RESEARCH_WIDE_DISCOVERY_AUTO_ACCEPT=false
NOTEWEAVE_RESEARCH_WIDE_DISCOVERY_ACCEPTED_PRECISION=0.0
NOTEWEAVE_RESEARCH_WIDE_DISCOVERY_PRECISION_THRESHOLD=0.90
# Read-only internal observation surface for Docker deterministic replay only.
NOTEWEAVE_RESEARCH_DISTRIBUTED_REPLAY_OBSERVATION=false
NOTEWEAVE_RESEARCH_REPLAY_WORKSPACE_ID=
NOTEWEAVE_RESEARCH_REPLAY_BEARER_TOKEN=
NOTEWEAVE_RESEARCH_REPLAY_FAULT_CONTROL_URL=
NOTEWEAVE_RESEARCH_ALLOW_REAL_PROVIDER_BENCHMARK=false

NOTEWEAVE_ARTIFACT_LLM_API_KEY=
NOTEWEAVE_ARTIFACT_LLM_BASE_URL=https://api.siliconflow.cn/v1
NOTEWEAVE_ARTIFACT_LLM_MODEL=Pro/zai-org/GLM-5.2
NOTEWEAVE_ARTIFACT_LLM_TIMEOUT_SECONDS=60
NOTEWEAVE_MCP_PROCESS_TIMEOUT_SECONDS=3600
NOTEWEAVE_ALLOW_PORTABLE_PDF_FALLBACK=false
NOTEWEAVE_ARTIFACT_DEBUG_ROUTES_ENABLED=false
NOTEWEAVE_SCHEDULING_POOL_SIZE=4
NOTEWEAVE_ANSWER_IO_CORE_SIZE=4
NOTEWEAVE_ANSWER_IO_MAX_SIZE=16
NOTEWEAVE_ANSWER_IO_QUEUE_CAPACITY=64
