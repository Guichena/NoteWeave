{
  "schema_version": "constraint-ops-eval-v1",
  "annotation_note": "约束抽取的模型侧评测集：抽取只走模型，没有关键词/正则规则，也没有规则兜底。每条 USER 消息的 ideal_ops 是「理想模型输出」，CI 用 stub 客户端原样回放，再由真实 merger 折叠；live 测试让真实模型自己给 ops，只比对最终 ACTIVE 的 slot/scope。targetId 里的 $active:<slot> 表示「从提示词给出的 ACTIVE 列表里取该槽位那一行的 id」，由测试桩解析，模拟模型按提示词引用已有约束。expected 每行用 (source_message_id, slot, op_index) 定位到稳定 id，status/scope/value 是落库字段；REVOKED 行额外给出 invalid_after_seq 与 superseded_by。",
  "cases": [
    {
      "id": "dangling-this-not-constraint",
      "note": "「这个不要」指代不明，不构成可复用的回答方式约束；只有「用中文解释」落成一次性语言要求（this-turn 落库折成 CURRENT_TOPIC）。",
      "messages": [
        {
          "id": "c1",
          "seq": 1,
          "role": "USER",
          "text": "这个不要，用中文解释一下",
          "topic": "cache"
        },
        {
          "id": "c2",
          "seq": 2,
          "role": "ASSISTANT",
          "text": "好的，下面用中文说明缓存一致性的两种写入顺序。",
          "topic": "cache"
        }
      ],
      "ideal_ops": [
        {
          "message_id": "c1",
          "ops": [
            {
              "op": "ADD",
              "slot": "language",
              "value": "中文",
              "scope": "this-turn",
              "confidence": 0.85
            }
          ]
        }
      ],
      "expected": [
        {
          "source_message_id": "c1",
          "slot": "language",
          "op_index": 0,
          "value": "中文",
          "scope": "CURRENT_TOPIC",
          "status": "ACTIVE"
        }
      ]
    },
