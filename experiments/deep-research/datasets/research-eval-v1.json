      "expected": {
        "terminal_state": "COMPLETED_VERIFIED",
        "required_column_keys": ["answer", "key_evidence"],
        "required_row_labels": ["OpenAI Responses API", "Anthropic Messages API"],
        "machine_checks": ["TERMINAL_STATE", "CITATION_TRACEABLE", "NO_UNSUPPORTED_CLAIM"],
        "reason_codes": []
