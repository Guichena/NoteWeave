{
  "dataset_key": "research-eval-v1",
  "dataset_version": "1.0.0",
  "frozen_at": "2026-09-18",
  "schema_version": "research-eval-dataset.v1",
  "purpose": "第 5 节完成定义与第 9 节验收矩阵的固定输入；按类别分层，禁止只保留成功样本。",
  "acceptance_environment": {
    "advanced_features_disabled": true,
    "worker_replicas": 1,
    "concurrency": 1,
    "provider": "REAL",
    "search_chain": ["serper", "wikipedia"],
    "fetch": "jina-or-workspace",
    "llm": "openai-compatible"
  },
  "machine_check_vocabulary": [
    "TERMINAL_STATE",
    "EXPLAINABLE_TERMINATION",
    "NO_UNSUPPORTED_CLAIM",
    "CITATION_TRACEABLE",
    "CELL_NO_REGRESSION",
    "REPLAN_LOCAL_ONLY",
    "EXTRACTION_REASON_CODE",
    "COUNTEREVIDENCE_BOUNDED",
    "NO_DUPLICATE_EXTERNAL_CALL",
    "STALE_CALLBACK_REJECTED",
    "INFRA_FAILURE_CLASSIFIED"
  ],
  "categories": {
    "NORMAL": "证据充分、来源可核验的正常问题；期望形成已验证结论。",
    "MISSING": "预算内无法获得合格证据的问题；期望诚实进入 COMPLETED_WITH_LIMITATIONS 或 INSUFFICIENT_EVIDENCE。",
    "CONFLICT": "可信来源结论相反的问题；期望显式保留冲突并按预算触发受限反证。",
    "FAULT": "证据本身正常，但注入 Provider、Worker、消息或回调故障；期望分类准确、不重复外部调用。"
  },
  "cases": [
