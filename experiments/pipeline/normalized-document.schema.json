{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noteweave.pipeline-normalized-document.v1",
  "title": "解析结果与人工版面标注的共同结构",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sample_id", "input_sha256", "parser", "parser_version", "page_count", "complete", "elements", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser": {"enum": ["GOLD", "DOCLING", "MINERU"]},
    "parser_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 300},
    "page_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "complete": {"type": "boolean"},
    "elements": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/element"}},
    "warnings": {"type": "array", "maxItems": 1000, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "bbox": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["left", "top", "right", "bottom", "coord_origin"],
      "properties": {
        "left": {"type": "number"}, "top": {"type": "number"},
        "right": {"type": "number"}, "bottom": {"type": "number"},
        "coord_origin": {"enum": ["TOPLEFT", "BOTTOMLEFT", "UNKNOWN"]}
      }
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["element_type", "text", "page", "bbox", "heading_level", "text_origin", "ocr_confidence", "table_cells", "table_structure_known", "reading_order_known"],
      "properties": {
        "element_type": {"enum": ["TITLE", "SECTION_HEADER", "TEXT", "TABLE", "CAPTION", "FORMULA", "CODE", "LIST_ITEM", "FOOTNOTE", "PICTURE"]},
        "text": {"type": "string", "maxLength": 20000000},
        "page": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000},
        "bbox": {"$ref": "#/$defs/bbox"},
        "heading_level": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
        "text_origin": {"enum": [null, "TEXT_LAYER", "OCR"]},
        "ocr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "table_cells": {
          "type": ["array", "null"], "minItems": 1, "maxItems": 1000,
          "items": {"type": "array", "minItems": 1, "maxItems": 1000,
            "items": {"type": "string", "maxLength": 1000000}}
        },
        "table_structure_known": {"type": "boolean"},
        "reading_order_known": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"table_structure_known": {"const": false}}},
          "then": {"properties": {"table_cells": {"type": "null"}}}},
        {"if": {"properties": {"table_structure_known": {"const": true}}},
          "then": {"properties": {"element_type": {"const": "TABLE"}, "table_cells": {"type": "array"}}}},
        {"if": {"properties": {"text_origin": {"enum": [null, "TEXT_LAYER"]}}},
          "then": {"properties": {"ocr_confidence": {"type": "null"}}}}
      ]
    }
  }
}
