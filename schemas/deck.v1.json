{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noteweave:deck:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "DECK"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "maxItems": 30
                }
              },
              "required": [
                "text",
                "anchors"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          },
          "speaker_notes": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 30
              }
            },
            "required": [
              "text",
              "anchors"
            ],
            "additionalProperties": false
          },
          "figure": {
            "type": "object",
            "properties": {
              "frame_id": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anchors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 30
                  }
                },
                "required": [
                  "text",
                  "anchors"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "frame_id",
              "caption"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "bullets"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 80
    }
  },
  "required": [
    "schema_version",
    "kind",
    "title",
    "slides"
  ],
  "additionalProperties": false
}
