{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noteweave:doc:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "DOC"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "paragraph",
                        "list"
                      ]
                    },
                    "statements": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "anchors": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            },
                            "minItems": 1,
                            "maxItems": 30
                          }
                        },
                        "required": [
                          "id",
                          "text",
                          "anchors"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1,
                      "maxItems": 80
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "statements"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "const": "figure"
                    },
                    "frame_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "caption": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "anchors": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1,
                          "maxItems": 30
                        }
                      },
                      "required": [
                        "text",
                        "anchors"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "frame_id",
                    "caption"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1,
            "maxItems": 80
          }
        },
        "required": [
          "id",
          "heading",
          "blocks"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 80
    }
  },
  "required": [
    "schema_version",
    "kind",
    "title",
    "sections"
  ],
  "additionalProperties": false
}
