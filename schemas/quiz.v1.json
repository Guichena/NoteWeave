{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noteweave:quiz:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "QUIZ"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 30
              }
            },
            "required": [
              "text",
              "anchors"
            ],
            "additionalProperties": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 8
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 30
              }
            },
            "required": [
              "text",
              "anchors"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "prompt",
          "options",
          "answer",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 80
    }
  },
  "required": [
    "schema_version",
    "kind",
    "title",
    "questions"
  ],
  "additionalProperties": false
}
