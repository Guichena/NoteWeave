{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noteweave:tree:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "TREE"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "title",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "anchors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 30
            }
          },
          "required": [
            "text",
            "anchors"
          ],
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "label",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
